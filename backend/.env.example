# Fair Drop Backend Configuration Example
# Copy this file to .env and configure for your local/deployment environment.
# NEVER commit .env or service account credentials to source control.

# Application Settings
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase & Firestore Configuration
# Provide the Firebase project ID (from your Firebase console project settings)
FIREBASE_PROJECT_ID=fair-drop-project

# Firestore Database ID (defaults to (default))
FIRESTORE_DATABASE_ID=(default)

# Authentication & Credentials
# Option A: Path to service account JSON key file (relative or absolute)
# e.g., FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
FIREBASE_CREDENTIALS_PATH=

# Option B: Raw service account JSON string (useful for cloud environments / container secrets)
# e.g., FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'
FIREBASE_CREDENTIALS_JSON=

# Option C: If running in Google Cloud or with GOOGLE_APPLICATION_CREDENTIALS set in environment,
# leave both FIREBASE_CREDENTIALS_PATH and FIREBASE_CREDENTIALS_JSON blank to use Application Default Credentials.

# Administrative Access Configuration
# Comma-separated list of Firebase Auth user emails or UIDs permitted to perform administrative drop mutations
ADMIN_EMAILS=admin@fairdrop.example.com
ADMIN_USER_IDS=
